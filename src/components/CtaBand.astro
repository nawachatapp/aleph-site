---
// Closing call to action: an indigo band with the WhatsApp number set large.
import Icon from './Icon.astro';
import { phone, whatsapp } from '../i18n/contact';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const copy = {
  ar: {
    title: 'لا تعرفونَ من أين تبدأون؟',
    text: 'أخبرونا قليلاً عن طفلِكم على واتساب، ونرشدُكم إلى الاختصاصيّةِ المناسبةِ وإلى أوّلِ موعد.',
  },
  en: {
    title: 'Not sure where to start?',
    text: 'Tell us a little about your child on WhatsApp, and we’ll point you to the right specialist and a first appointment.',
  },
}[lang];
---
<section class="cta on-dark">
  <div class="wrap cta__inner">
    <div>
      <h2>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>
    <div class="cta__actions">
      <a class="cta__number" href={whatsapp} target="_blank" rel="noopener" dir="ltr">
        <Icon name="whatsapp" /> {phone.label}
      </a>
      <div class="cta__btns">
        <a class="btn" href={whatsapp} target="_blank" rel="noopener">{t('cta.whatsapp')}</a>
        <a class="btn btn--ghost" href={`tel:${phone.tel}`}><Icon name="phone" /> {t('cta.call')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta{
    position:relative;
    overflow:hidden;
    background:var(--indigo);
    color:var(--ink-invert);
    padding-block:var(--sp-6);
  }
  /* The teal stroke of the alef, rising from the band's far edge. */
  .cta::before{
    content:"";
    position:absolute;
    inset-block-end:-40%;
    inset-inline-end:-60px;
    inline-size:260px;
    block-size:150%;
    border-start-start-radius:200px;
    border-start-end-radius:30px;
    background:var(--teal);
    opacity:.22;
  }
  .cta__inner{
    position:relative;
    display:grid;
    grid-template-columns:1.2fr 1fr;
    gap:var(--sp-5);
    align-items:center;
  }
  .cta h2{color:var(--ink-invert);margin-bottom:var(--sp-3)}
  .cta p{color:rgba(255,247,241,.82);font-size:var(--step-1);margin:0}
  .cta__number{
    display:inline-flex;
    align-items:center;
    gap:14px;
    font-size:clamp(30px,4.5vw,48px);
    font-weight:600;
    color:var(--amber);
    text-decoration:none;
    letter-spacing:.02em;
    margin-bottom:var(--sp-3);
  }
  .cta__number :global(svg){inline-size:.8em;block-size:.8em}
  .cta__btns{display:flex;flex-wrap:wrap;gap:var(--sp-3)}

  @media (max-width:820px){
    .cta__inner{grid-template-columns:1fr}
  }
</style>
