---
// The online-portal entry point. One component so the header, footer and
// contact page stay in step: while `portalUrl` is null it renders a disabled
// "coming soon" control rather than a link to nowhere.
import Icon from './Icon.astro';
import { portalUrl } from '../i18n/contact';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  /** `tool` is the round header button; `pill` is a labelled button. */
  variant?: 'tool' | 'pill';
  class?: string;
}
const { variant = 'pill', class: cls } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const label = t('cta.portal');
const tip = portalUrl ? label : `${label} · ${t('cta.soon')}`;
---
{portalUrl ? (
  <a
    class:list={['portal', `portal--${variant}`, cls]}
    href={portalUrl}
    target="_blank"
    rel="noopener"
    aria-label={variant === 'tool' ? label : undefined}
    data-tip={variant === 'tool' ? tip : undefined}
  >
    <Icon name="portal" />
    {variant === 'pill' && <span>{label}</span>}
  </a>
) : (
  <span
    class:list={['portal', `portal--${variant}`, 'is-soon', cls]}
    role="link"
    aria-disabled="true"
    tabindex="0"
    aria-label={tip}
    data-tip={variant === 'tool' ? tip : undefined}
  >
    <Icon name="portal" />
    {variant === 'pill' && <span>{label}</span>}
    {variant === 'pill' && <span class="portal__soon">{t('cta.soon')}</span>}
  </span>
)}

<style>
  .portal{
    display:inline-flex;
    align-items:center;
    gap:8px;
    text-decoration:none;
    font-weight:500;
  }
  .portal :global(svg){inline-size:19px;block-size:19px;flex:none}

  .portal--pill{
    padding:10px 18px;
    border-radius:var(--r-pill);
    border:2px solid var(--teal);
    color:var(--teal-ink);
    background:transparent;
    transition:background var(--dur) var(--ease);
  }
  a.portal--pill:hover{background:var(--teal-pale)}
  .portal--pill.is-soon{border-style:dashed;cursor:default}

  .portal__soon{
    font-size:11px;
    padding:2px 8px;
    border-radius:var(--r-pill);
    background:var(--amber-pale);
    color:var(--amber-ink);
  }
</style>
