---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
import { langs, type Lang } from '../../i18n/ui';
import { localisedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const copy = {
  ar: {
    title: 'الفريق',
    description: 'تعرّفوا إلى اختصاصيّات مركز ألِف التربوي ومؤهّلاتهنّ.',
    eyebrow: 'من يعملُ مع طفلِكم',
    heading: 'فريقُ ألِف',
    lead: 'خمسُ اختصاصيّاتٍ بخبراتٍ تمتدُّ من الجامعةِ اللبنانيّة والجامعةِ الأميركيّة في بيروت إلى برامجِ منظّمةِ الصحّةِ العالميّة.',
    service: 'عن الخدمة',
  },
  en: {
    title: 'Our team',
    description: 'Meet the specialists of Aleph Educational Center and their qualifications.',
    eyebrow: 'Who works with your child',
    heading: 'The Aleph team',
    lead: 'Five specialists, with training from the Lebanese University and the American University of Beirut to World Health Organization programmes.',
    service: 'About the service',
  },
}[lang];
---
<BaseLayout title={copy.title} description={copy.description}>
  <PageHeader eyebrow={copy.eyebrow} title={copy.heading} lead={copy.lead} />

  <section class="section">
    <div class="wrap people">
      {services.map((s) => (
        <article class="person" id={s.id}>
          <header class="person__head">
            <ServiceIcon id={s.id} size="lg" />
            <div>
              <h2 class="person__name">{s.specialist.name[lang]}</h2>
              {lang === 'ar' && <p class="latin-caps">{s.specialist.latin}</p>}
              <p class="person__role">{s.specialist.role[lang]}</p>
            </div>
          </header>
          <ul class="person__creds">
            {s.specialist.credentials[lang].map((c) => <li>{c}</li>)}
          </ul>
          {s.specialist.conditions && (
            <ul class="person__conditions">
              {s.specialist.conditions[lang].map((c) => <li>{c}</li>)}
            </ul>
          )}
          <a class="person__link" href={`${localisedPath('services', lang)}#${s.id}`}>
            {copy.service}: {s.name[lang]} <Icon name="arrow" />
          </a>
        </article>
      ))}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .people{display:grid;gap:var(--sp-5)}
  .person{
    display:grid;
    grid-template-columns:minmax(260px,.9fr) 1.6fr;
    grid-template-areas:
      "head creds"
      "head cond"
      "head link";
    grid-template-rows:auto auto 1fr;
    column-gap:var(--sp-6);
    padding:var(--sp-5);
    border-radius:var(--r-lg);
    background:var(--surface);
    border:1px solid var(--line);
  }
  .person__head{grid-area:head;display:flex;flex-direction:column;gap:var(--sp-4)}
  .person__name{font-size:var(--step-3);line-height:1.3}
  .person__head .latin-caps{margin:6px 0 0}
  .person__role{
    margin:var(--sp-2) 0 0;
    font-size:var(--step-1);
    font-weight:500;
    color:var(--amber-ink);
  }

  .person__creds{grid-area:creds;list-style:none;margin:0;padding:0}
  .person__creds li{
    position:relative;
    padding-inline-start:26px;
    margin-bottom:var(--sp-3);
  }
  .person__creds li::before{
    content:"";
    position:absolute;
    inset-inline-start:2px;
    top:.7em;
    inline-size:10px;
    block-size:10px;
    border-radius:3px;
    background:var(--teal);
  }
  .person__conditions{
    grid-area:cond;
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    list-style:none;
    margin:0 0 var(--sp-4);
    padding:0;
    padding-inline-start:26px;
  }
  .person__conditions li{
    margin:0;
    padding:4px 14px;
    border-radius:var(--r-pill);
    background:var(--teal-pale);
    color:var(--teal-ink);
    font-size:var(--step--1);
  }
  .person__link{
    grid-area:link;
    align-self:end;
    justify-self:start;
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin-inline-start:26px;
    font-weight:500;
    text-decoration:none;
  }
  .person__link :global(svg){inline-size:18px;block-size:18px}

  @media (max-width:860px){
    .person{
      grid-template-columns:1fr;
      grid-template-areas:"head" "creds" "cond" "link";
      grid-template-rows:auto;
      row-gap:var(--sp-3);
      padding:var(--sp-4);
    }
    .person__head{flex-direction:row;align-items:center}
  }
  @media (max-width:520px){
    .person__head{flex-direction:column;align-items:flex-start}
  }
</style>
